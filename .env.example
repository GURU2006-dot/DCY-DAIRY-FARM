# Reference only. Copy backend/.env.example to backend/.env and frontend/.env.example to frontend/.env.local.
# Server secrets are private; never expose these through VITE_ variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=3001
NODE_ENV=development
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
BCRYPT_SALT_ROUNDS=12
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Public frontend build configuration (not secret)
VITE_API_BASE_URL=/api
VITE_DEMO_MODE=false
