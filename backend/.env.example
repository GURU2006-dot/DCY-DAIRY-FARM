# PostgreSQL connection string. Use a managed Postgres service for deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PORT=3001
NODE_ENV=development
# Generate with: openssl rand -base64 48. Required in production.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Admin bootstrap inputs are read once by `npm run admin:init`; never commit them.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
BCRYPT_SALT_ROUNDS=12
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# For a local PostgreSQL server without TLS only:
# PGSSLMODE=disable
# Optional custom frontend build directory:
# FRONTEND_DIST_DIR=../frontend/dist
